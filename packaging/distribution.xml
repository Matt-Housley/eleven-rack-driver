<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Eleven Rack Audio Driver</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- Apple Silicon only; no per-component customization. -->
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>

    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Eleven Rack Audio Driver">
        <pkg-ref id="co.uk.matthousley.ElevenRack.pkg"/>
    </choice>

    <pkg-ref id="co.uk.matthousley.ElevenRack.pkg" version="1.0.1" onConclusion="none">ElevenRackComponent.pkg</pkg-ref>
</installer-gui-script>
